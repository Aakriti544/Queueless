import json
import re
from io import StringIO
from unittest.mock import patch

from django.contrib.auth.hashers import check_password, make_password
from django.core import mail
from django.core.management import call_command
from django.db import OperationalError
from django.test import Client, TestCase, override_settings

from user.models import (
    CustomerNotification,
    EmailOTP,
    Organization,
    Queue,
    QueueTokenCounter,
    Service,
    User,
)


class AdminModuleTests(TestCase):
    def setUp(self):
        self.admin = self.make_user("admin@example.test", "admin")
        self.customer = self.make_user("customer@example.test", "customer")
        self.staff = self.make_user("staff@example.test", "staff")
        self.client = Client()
        self.login_session(self.client, self.admin)

    @staticmethod
    def make_user(email, role, is_active=True):
        return User.objects.create(
            username=email.split("@")[0],
            email=email,
            password="hashed-test-value",
            role=role,
            is_active=is_active,
        )

    @staticmethod
    def login_session(client, user):
        session = client.session
        session["user_id"] = user.id
        session["user_role"] = user.role
        session["is_logged_in"] = True
        session.save()

    @staticmethod
    def patch_json(client, url, payload):
        return client.patch(
            url,
            data=json.dumps(payload),
            content_type="application/json",
            HTTP_X_CSRFTOKEN=client.cookies.get("csrftoken", {}).value
            if client.cookies.get("csrftoken")
            else "",
        )

    def test_customer_list_includes_active_and_inactive_accounts(self):
        self.customer.is_active = False
        self.customer.save(update_fields=["is_active"])

        response = self.client.get("/api/user/admin-customers/")

        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json()["count"], 1)
        self.assertFalse(response.json()["customers"][0]["is_active"])

    def test_customer_activation_does_not_remove_queue_history(self):
        queue = Queue.objects.create(
            user=self.customer,
            service="General",
            token_number=101,
            status="completed",
        )
        response = self.patch_json(
            self.client,
            f"/api/user/customers/{self.customer.id}/status/",
            {"is_active": False},
        )

        self.assertEqual(response.status_code, 200)
        self.customer.refresh_from_db()
        self.assertFalse(self.customer.is_active)
        self.assertTrue(Queue.objects.filter(pk=queue.pk).exists())

        response = self.patch_json(
            self.client,
            f"/api/user/customers/{self.customer.id}/status/",
            {"is_active": True},
        )
        self.assertEqual(response.status_code, 200)
        self.customer.refresh_from_db()
        self.assertTrue(self.customer.is_active)

    def test_staff_list_includes_inactive_accounts_and_status_can_be_restored(self):
        self.staff.is_active = False
        self.staff.save(update_fields=["is_active"])
        response = self.client.get("/api/user/admin-staff/")
        self.assertEqual(response.status_code, 200)
        self.assertFalse(response.json()["staff"][0]["is_active"])

        response = self.patch_json(
            self.client,
            f"/api/user/staff/{self.staff.id}/status/",
            {"is_active": True},
        )
        self.assertEqual(response.status_code, 200)
        self.staff.refresh_from_db()
        self.assertTrue(self.staff.is_active)

    def test_staff_delete_route_permanently_deletes_only_selected_account(self):
        other_staff = self.make_user("otherstaff@example.test", "staff")
        queue = Queue.objects.create(
            user=self.customer,
            called_by=self.staff,
            service="General",
            token_number=102,
            status="completed",
        )

        response = self.client.delete(f"/api/user/staff/{self.staff.id}/delete/")
        self.assertEqual(response.status_code, 200, response.content)
        self.assertFalse(User.objects.filter(pk=self.staff.pk).exists())
        self.assertTrue(User.objects.filter(pk=other_staff.pk, role="staff").exists())
        self.assertTrue(User.objects.filter(pk=self.customer.pk, role="customer").exists())
        self.assertTrue(User.objects.filter(pk=self.admin.pk, role="admin").exists())
        queue.refresh_from_db()
        self.assertEqual(queue.token_number, 102)
        self.assertEqual(queue.user_id, self.customer.pk)
        self.assertIsNone(queue.called_by_id)

        login = Client().post(
            "/api/user/login/",
            data=json.dumps({"email": self.staff.email, "password": "secret"}),
            content_type="application/json",
        )
        self.assertEqual(login.status_code, 401)

    def test_staff_with_owned_queue_history_is_not_deleted(self):
        queue = Queue.objects.create(
            user=self.staff,
            service="Legacy",
            token_number=103,
            status="completed",
        )
        response = self.client.delete(f"/api/user/staff/{self.staff.id}/delete/")
        self.assertEqual(response.status_code, 409)
        self.assertTrue(User.objects.filter(pk=self.staff.pk).exists())
        self.assertTrue(Queue.objects.filter(pk=queue.pk, token_number=103).exists())

    def test_staff_creation_accepts_simple_password_and_hashes_it(self):
        password = "111111"
        response = self.client.post(
            "/api/user/create-staff/",
            data=json.dumps(
                {"username": "New Staff", "email": "newstaff@example.test", "password": password}
            ),
            content_type="application/json",
        )
        self.assertEqual(response.status_code, 201, response.content)
        created = User.objects.get(email="newstaff@example.test", role="staff")
        self.assertTrue(check_password(password, created.password))
        self.assertNotEqual(password, created.password)

    def test_history_separates_terminal_statuses_and_keeps_inactive_relations(self):
        self.customer.is_active = False
        self.customer.save(update_fields=["is_active"])
        self.staff.is_active = False
        self.staff.save(update_fields=["is_active"])
        for number, status in ((201, "completed"), (202, "cancelled"), (203, "skipped")):
            Queue.objects.create(
                user=self.customer,
                called_by=self.staff,
                service="General",
                token_number=number,
                status=status,
            )

        for status in ("completed", "cancelled", "skipped"):
            response = self.client.get(f"/api/user/admin/queue-history/{status}/")
            self.assertEqual(response.status_code, 200)
            record = response.json()["records"][0]
            self.assertEqual(record["status"], status)
            self.assertFalse(record["customer_active"])
            self.assertEqual(record["called_by"], self.staff.username)
            self.assertFalse(record["called_by_active"])

    def test_admin_can_read_and_update_real_organization_name(self):
        Organization.objects.create(id=1, name="Sample Nepal Services")
        response = self.client.get("/api/user/organization/")
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json()["organization"]["name"], "Sample Nepal Services")

        response = self.client.put(
            "/api/user/organization/update/",
            data=json.dumps({"name": "QueueLess Kathmandu"}),
            content_type="application/json",
            HTTP_X_CSRFTOKEN=self.client.cookies.get("csrftoken", {}).value
            if self.client.cookies.get("csrftoken")
            else "",
        )
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json()["organization"]["name"], "QueueLess Kathmandu")

    def test_dashboard_uses_dynamic_organization_label_and_user_history_controls(self):
        response = self.client.get("/admindashboard.html/")
        self.assertEqual(response.status_code, 200)
        self.assertContains(response, 'id="adminOrganizationName"')
        self.assertContains(response, 'id="queueHistoryTable"')
        self.assertNotContains(response, "1 Bank")
        self.assertNotContains(response, "staffPhone")

    def test_admin_can_manage_services(self):
        response = self.client.post(
            "/api/user/services/create/",
            data=json.dumps({"name": "Appointments", "description": "General"}),
            content_type="application/json",
        )
        self.assertEqual(response.status_code, 201)

        service_id = response.json()["service"]["id"]
        response = self.patch_json(
            self.client,
            f"/api/user/services/{service_id}/toggle/",
            {"is_active": False},
        )
        self.assertEqual(response.status_code, 200)
        self.assertFalse(response.json()["service"]["is_active"])

    def test_inactive_admin_with_stale_session_is_rejected_and_flushed(self):
        self.admin.is_active = False
        self.admin.save(update_fields=["is_active"])

        response = self.client.get("/api/user/admin-customers/")

        self.assertEqual(response.status_code, 401)
        self.assertNotIn("user_id", self.client.session)

    def test_customer_and_staff_cannot_access_admin_api(self):
        for user in (self.customer, self.staff):
            client = Client()
            self.login_session(client, user)
            response = client.get("/api/user/admin-customers/")
            self.assertEqual(response.status_code, 403)

    def test_unauthenticated_user_cannot_access_admin_api(self):
        response = Client().get("/api/user/admin-customers/")
        self.assertEqual(response.status_code, 401)

    def test_admin_state_change_requires_csrf(self):
        client = Client(enforce_csrf_checks=True)
        self.login_session(client, self.admin)
        client.get("/admindashboard.html/")
        url = f"/api/user/customers/{self.customer.id}/status/"
        payload = json.dumps({"is_active": False})

        rejected = client.patch(url, data=payload, content_type="application/json")
        self.assertEqual(rejected.status_code, 403)
        accepted = client.patch(
            url,
            data=payload,
            content_type="application/json",
            HTTP_X_CSRFTOKEN=client.cookies["csrftoken"].value,
        )
        self.assertEqual(accepted.status_code, 200)


class CustomerModuleTests(TestCase):
    def setUp(self):
        QueueTokenCounter.objects.get_or_create(name="main")
        self.customer = User.objects.create(username="customer", email="customer@customer.test", password="hash", role="customer")
        self.other = User.objects.create(username="other", email="other@customer.test", password="hash", role="customer")
        self.client = Client()
        session = self.client.session
        session.update({"user_id": self.customer.pk, "user_role": "customer", "is_logged_in": True})
        session.save()

    def test_customer_catalog_and_join_require_active_service_id(self):
        available = Service.objects.create(name="Appointments")
        Service.objects.create(name="Inactive", is_active=False)
        catalog = self.client.get("/api/user/customer-services/").json()
        self.assertEqual([row["id"] for row in catalog["services"]], [available.pk])
        bad = self.client.post("/api/user/join-queue/", data=json.dumps({"service_id": 999}), content_type="application/json")
        self.assertEqual(bad.status_code, 400)
        joined = self.client.post("/api/user/join-queue/", data=json.dumps({"service_id": available.pk}), content_type="application/json")
        self.assertEqual(joined.status_code, 201)
        self.assertEqual(joined.json()["queue"]["service"], "Appointments")

    def test_history_and_notifications_are_customer_owned(self):
        Queue.objects.create(user=self.customer, service="Appointments", token_number=5, status="completed")
        CustomerNotification.objects.create(user=self.customer, title="Called", message="Proceed")
        CustomerNotification.objects.create(user=self.other, title="Private", message="Other account")
        history = self.client.get("/api/user/customer-history/").json()["records"]
        notes = self.client.get("/api/user/customer-notifications/").json()["notifications"]
        self.assertEqual(len(history), 1)
        self.assertEqual(len(notes), 1)
        self.assertEqual(notes[0]["title"], "Called")

    def test_profile_updates_name_but_not_role_or_email(self):
        response = self.client.patch("/api/user/customer-profile/", data=json.dumps({"username": "New Name", "role": "admin", "email": "changed@test"}), content_type="application/json")
        self.assertEqual(response.status_code, 200)
        self.customer.refresh_from_db()
        self.assertEqual(self.customer.username, "New Name")
        self.assertEqual(self.customer.role, "customer")
        self.assertEqual(self.customer.email, "customer@customer.test")

    @patch("user.views.queue.Queue.objects.filter", side_effect=OperationalError("schema unavailable"))
    def test_history_database_failure_is_reported_as_json(self, _query):
        response = self.client.get("/api/user/customer-history/")
        self.assertEqual(response.status_code, 503)
        self.assertEqual(response["Content-Type"], "application/json")
        self.assertIn("migrations", response.json()["message"])

    def test_customer_back_to_dashboard_navigation_is_registered(self):
        response = self.client.get("/notifications.html/")
        self.assertEqual(response.status_code, 200)
        self.assertContains(response, "function goDashboard()")
        self.assertContains(response, "/customerDashboard.html/")

    def test_customer_pages_render_and_join_has_only_service_selector(self):
        for path in (
            "/customerDashboard.html/",
            "/joinqueue.html/",
            "/queuestatus.html/",
            "/notifications.html/",
            "/profile.html/",
        ):
            with self.subTest(path=path):
                self.assertEqual(self.client.get(path).status_code, 200)
        join_page = self.client.get("/joinqueue.html/")
        self.assertEqual(join_page.content.decode().count("<select"), 1)
        self.assertContains(join_page, "Select Service")

    def test_unauthenticated_customer_history_returns_json_401(self):
        response = Client().get("/api/user/customer-history/")
        self.assertEqual(response.status_code, 401)
        self.assertEqual(response["Content-Type"], "application/json")


class ExistingQueueReadRegressionTests(TestCase):
    def test_customer_and_staff_can_still_read_shared_queue(self):
        customer = User.objects.create(
            username="customer", email="customer@queue.test", password="x", role="customer"
        )
        staff = User.objects.create(
            username="staff", email="staff@queue.test", password="x", role="staff"
        )
        entry = Queue.objects.create(
            user=customer,
            service="General",
            token_number=301,
            status="waiting",
        )

        customer_client = Client()
        AdminModuleTests.login_session(customer_client, customer)
        customer_response = customer_client.get("/api/user/my-queue/")
        self.assertEqual(customer_response.status_code, 200)
        self.assertEqual(customer_response.json()["queue"]["id"], entry.id)

        staff_client = Client()
        AdminModuleTests.login_session(staff_client, staff)
        staff_response = staff_client.get("/api/user/staff-queue/")
        self.assertEqual(staff_response.status_code, 200)
        self.assertEqual(staff_response.json()["queues"][0]["id"], entry.id)


class FlexiblePasswordTests(TestCase):
    def test_signup_page_has_no_password_minimum_length_rule(self):
        response = self.client.get("/login.html/")
        self.assertEqual(response.status_code, 200)
        self.assertNotContains(response, 'minlength="6"')
        self.assertNotContains(response, "password.length < 6")

    @override_settings(
        EMAIL_BACKEND="django.core.mail.backends.locmem.EmailBackend",
        DEFAULT_FROM_EMAIL="noreply@example.test",
    )
    def test_customer_signup_otp_and_login_accept_short_repeated_password(self):
        password = "aaaaaa"
        signup = self.client.post(
            "/api/user/signup/",
            data=json.dumps({
                "username": "Simple Password Customer",
                "email": "simple-password@example.test",
                "password": password,
                "confirm_password": password,
            }),
            content_type="application/json",
        )
        self.assertEqual(signup.status_code, 200, signup.content)
        otp_record = EmailOTP.objects.get(email="simple-password@example.test")
        self.assertNotEqual(otp_record.password, password)
        self.assertTrue(check_password(password, otp_record.password))
        otp = re.search(r"\b\d{6}\b", mail.outbox[-1].body).group(0)

        verified = self.client.post(
            "/api/user/verify-otp/",
            data=json.dumps({"email": otp_record.email, "otp": otp}),
            content_type="application/json",
        )
        self.assertEqual(verified.status_code, 200, verified.content)

        login = self.client.post(
            "/api/user/login/",
            data=json.dumps({"email": otp_record.email, "password": password}),
            content_type="application/json",
        )
        self.assertEqual(login.status_code, 200, login.content)
        account = User.objects.get(email=otp_record.email)
        self.assertTrue(check_password(password, account.password))

    def test_staff_and_admin_login_accept_short_passwords(self):
        for role, email, expected_redirect in (
            ("staff", "short-staff@example.test", "/staffdashboard.html/"),
            ("admin", "short-admin@example.test", "/admindashboard.html/"),
        ):
            User.objects.create(
                username=role,
                email=email,
                password=make_password("1"),
                role=role,
            )
            response = self.client.post(
                "/api/user/login/",
                data=json.dumps({"email": email, "password": "1"}),
                content_type="application/json",
            )
            self.assertEqual(response.status_code, 200, response.content)
            self.assertEqual(response.json()["redirect"], expected_redirect)

    @override_settings(
        ADMIN_USERNAME="simple-admin",
        ADMIN_EMAIL="simple-admin@example.test",
        ADMIN_PASSWORD="1",
    )
    def test_initial_admin_command_accepts_short_password_and_hashes_it(self):
        call_command("create_queueless_admin", stdout=StringIO())
        account = User.objects.get(email="simple-admin@example.test", role="admin")
        self.assertTrue(check_password("1", account.password))
        self.assertNotEqual("1", account.password)
