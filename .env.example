# Copy to .env for local configuration. Never commit .env or real credentials.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=queueless
DB_USER=queueless_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Used only by setup_mysql.py to configure the local MySQL application account.
MYSQL_ROOT_PASSWORD=
MYSQL_ROOT_HOST=127.0.0.1
MYSQL_ROOT_PORT=3306

# Brevo Transactional Email API (HTTPS)
BREVO_API=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_HOST_USER=

# Web Push (set once in your deployment's secret environment; never commit keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:push-admin@example.com
# Stable Fernet key used to encrypt subscriptions. Do not regenerate on restart.
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
